<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>e8368e6e-356a-4f89-8c34-1b14a145a742</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>SEW Energy B.V.</ProviderName>
  <DefaultLocale>nl-NL</DefaultLocale>
  <DisplayName DefaultValue="SEW DMS" />
  <Description DefaultValue="Mail opslaan bij project, offerte of order in het SEW DMS: bij lezen, bij versturen en per gesprek." />
  <IconUrl DefaultValue="https://{{HOST}}/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://{{HOST}}/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://www.sewenergy.nl" />
  <AppDomains>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts><Host Name="Mailbox" /></Hosts>
  <Requirements>
    <Sets><Set Name="Mailbox" MinVersion="1.5" /></Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://{{HOST}}/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://{{HOST}}/compose.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.12"><bt:Set Name="Mailbox" /></bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Controle bij versturen: nieuwe Outlook en web laden commands.html, klassieke Outlook laadt commands.js -->
          <Runtimes>
            <Runtime resid="commandsUrl">
              <Override type="javascript" resid="commandsJsUrl" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="commandsUrl" />

            <!-- Lezen: knop "Opslaan in DMS" -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="sewDmsGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="sewDmsOpen">
                    <Label resid="buttonLabel" />
                    <Supertip>
                      <Title resid="buttonLabel" />
                      <Description resid="buttonTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Opstellen: knop "Project kiezen" -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="sewDmsComposeGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="sewComposeOpen">
                    <Label resid="composeLabel" />
                    <Supertip>
                      <Title resid="composeLabel" />
                      <Description resid="composeTip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="composeUrl" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Controle bij versturen (Smart Alerts). PromptUser: de gebruiker kan altijd toch versturen.
                 Uitrollen via het Microsoft 365-beheercentrum (Integrated apps), niet met de hand installeren. -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="PromptUser" />
              </LaunchEvents>
              <SourceLocation resid="commandsUrl" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://{{HOST}}/assets/icon-16.png" />
          <bt:Image id="icon32" DefaultValue="https://{{HOST}}/assets/icon-32.png" />
          <bt:Image id="icon80" DefaultValue="https://{{HOST}}/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="taskpaneUrl" DefaultValue="https://{{HOST}}/taskpane.html" />
          <bt:Url id="composeUrl" DefaultValue="https://{{HOST}}/compose.html" />
          <bt:Url id="commandsUrl" DefaultValue="https://{{HOST}}/commands.html" />
          <bt:Url id="commandsJsUrl" DefaultValue="https://{{HOST}}/commands.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="SEW" />
          <bt:String id="buttonLabel" DefaultValue="Opslaan in DMS" />
          <bt:String id="composeLabel" DefaultValue="Project kiezen" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="buttonTip" DefaultValue="Sla deze mail op bij een project, offerte of order in het SEW DMS." />
          <bt:String id="composeTip" DefaultValue="Kies het project; na versturen staat de mail vanzelf in het SEW DMS." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
